# Copy this file to .env and fill in real values for local development.

# SQLite connection string. Prisma reads this via prisma.config.ts.
DATABASE_URL="file:./prisma/dev.db"

# Used by Auth.js (NextAuth) to sign session/JWT cookies. Generate with:
#   npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"

# Required to call GET /api/stats. Any long random string; pass it back as
# the x-stats-key header when calling that endpoint.
STATS_API_KEY="replace-with-a-long-random-string"

# Optional: overrides where uploaded files are stored on disk.
# Defaults to ./uploads when unset. In production (Railway) this should
# point at the mounted persistent volume, e.g. /data/uploads.
# UPLOADS_DIR="./uploads"
